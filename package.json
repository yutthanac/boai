{
  "name": "noar-ai-assistant",
  "version": "1.0.0",
  "type": "module",
  "description": "Personal AI Desktop Assistant (Noar / โนอา) v1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc electron/main.ts electron/ipc-handlers.ts electron/preload.ts electron/tray.ts electron/line-webhook.ts --outDir dist-electron --module commonjs --target es2020 --esModuleInterop --skipLibCheck",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "webhook": "node scripts/line-webhook.js"
  },
  "keywords": [
    "ai",
    "desktop-assistant",
    "thai-voice",
    "electron",
    "react",
    "wake-word"
  ],
  "author": "Bo AI Team",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.noar.assistant",
    "productName": "NOAR AI Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NOAR AI Assistant"
    }
  }
}
