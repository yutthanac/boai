# ==========================================
# Bo AI — Environment Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# AI Providers
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-flash-lite-latest

VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-4o

VITE_CLAUDE_API_KEY=your_claude_api_key_here
VITE_CLAUDE_MODEL=claude-3-5-sonnet-20241022

VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROK_API_KEY=your_grok_api_key_here

# Open-Meteo Weather API
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
VITE_OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1

# Default Location for Weather
VITE_DEFAULT_CITY=กรุงเทพมหานคร
VITE_DEFAULT_LATITUDE=13.7563
VITE_DEFAULT_LONGITUDE=100.5018
VITE_WEATHER_TIMEZONE=Asia/Bangkok

# LINE Official Account (LINE Messaging API & Webhook Chatbot)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
VITE_LINE_CHANNEL_SECRET=your_line_channel_secret_here
VITE_LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here
VITE_LINE_USER_ID=your_line_user_id_here
LINE_WEBHOOK_PORT=3000

